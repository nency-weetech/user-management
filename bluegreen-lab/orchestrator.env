# Initial application versions
BLUE_VERSION=V1
GREEN_VERSION=V1

# k6 configuration
RUN_ID=bluegreen-001
RATE=20
DURATION=30m
BASE_URL=http://127.0.0.1:8088

# Health check
HEALTH_TIMEOUT_MS=60000

# Traffic drain grace period
DRAIN_SECONDS=15

# Post-migration observation
POST_CONTRACT_OBSERVATION_SECONDS=30